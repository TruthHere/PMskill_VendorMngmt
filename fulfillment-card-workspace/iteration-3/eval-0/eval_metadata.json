{
  "eval_id": 0,
  "eval_name": "supply-good",
  "eval_kind": "standard",
  "prompt": "用 fulfillment-card 渲染夹具 supply-good.json：合格纯供应采购包，含 3 个中英付款节点、请款附件与计划时间区间。",
  "assertions": [
    "card HTML exists",
