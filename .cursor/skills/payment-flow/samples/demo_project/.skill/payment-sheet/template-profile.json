{
  "id": "demo",
  "engine": "insert_rows",
  "title": "请款单",
  "title_en": "Payment Application",
  "download_label": "下载请款单（Excel）",
  "vendor_section_title": "请款单抬头（供应商填）",
  "invoice_sheet": "Invoice",
  "drop_sheets": ["Advance Payment Schedule"],
  "form": {
    "show_includes_variations": true,
    "user_fields": [
      {
        "key": "po_number",
        "label": "PO 号",
        "label_en": "PO Number",
        "required": true,
        "placeholder": "合同 / PO 首页上的编号"
      },
      {
        "key": "vendor_ref",
        "label": "供应商编号",
        "label_en": "Vendor Reference",
        "required": true,
        "placeholder": "PO 上的供应商编号"
      },
      {
        "key": "contact_name",
        "label": "联系人",
        "label_en": "Contact Point",
        "required": true,
        "placeholder": "请款对接人姓名"
      },
      {
        "key": "contact_mobile",
        "label": "手机",
        "label_en": "Contact Number",
        "required": true,
        "placeholder": "手机号",
        "inputmode": "tel"
      },
      {
        "key": "office_phone",
        "label": "公司电话",
        "label_en": "Office",
        "required": false,
        "placeholder": "没有可留空",
        "inputmode": "tel"
      },
      {
        "key": "office_address",
        "label": "公司地址",
        "label_en": "Office Address",
        "required": true,
        "placeholder": "开票 / 公司注册地址"
      }
    ]
  },
  "writes": [
    {"from": "payment_no", "cell": "B1", "type": "text", "format": "PAYMENT NO: {value}"},
    {"from": "payment_no", "cell": "Q19", "type": "number"},
    {"from": "period_count", "cell": "P23", "type": "number"},
    {"from": "project_name", "cell": "C2", "type": "text"},
    {"from": "division", "cell": "C3", "type": "text"},
    {"from": "vendor_name", "cell": "C4", "type": "text"},
    {"from": "vendor_name", "cell": "C11", "type": "text"},
    {"from": "work_package", "cell": "C5", "type": "text"},
    {"from": "vendor_ref", "cell": "C6", "type": "text"},
    {"from": "po_number", "cell": "C7", "type": "text"},
    {"from": "contact_name", "cell": "C12", "type": "text"},
    {"from": "contact_mobile", "cell": "C13", "type": "text"},
    {"from": "office_phone", "cell": "C14", "type": "text"},
    {"from": "office_address", "cell": "K12", "type": "text"},
    {"from": "billing_entity", "cell": "C19", "type": "text"},
    {"from": "nodes_overview", "cell": "B22", "type": "text"},
    {"from": "division_code", "cell": "B19", "type": "auto"},
    {"from": "po_value_excl_tax", "cell": "C8", "type": "money"},
    {"from": "contract_value_excl_tax", "cell": "C9", "type": "money"},
    {"from": "variations_to_date", "cell": "I30", "type": "money"}
  ],
  "vat": {
    "from": "vat_note_pct",
    "cells": ["D8", "D9"],
    "format": "(CNY exclude {value}% VAT)"
  },
  "claim_lines": {
    "start_row": 36,
    "current_row": 37,
    "name_col": "B",
    "amount_col": "Q",
    "previously_certified_row": 41,
    "insert_copies_of_row": 36,
    "name_merge": "B:M"
  },
  "notes": "本项目已认模板：明细区插既往请款行。格子以本文件为准。"
}
